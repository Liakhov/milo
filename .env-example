# Telegram
TELEGRAM_BOT_TOKEN=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (Whisper STT)
OPENAI_API_KEY=

# Logging (debug | info | warn | error)
LOG_LEVEL=info

# Private by default. Set to true only to intentionally allow every Telegram user.
# When true, ALLOWED_USER_IDS does not restrict access.
PUBLIC_MODE=false

# List of Telegram User IDs allowed to use the bot, separated by commas.
# With PUBLIC_MODE=false, at least one valid positive numeric ID is required.
ALLOWED_USER_IDS=12345678,87654321
